# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/

# Dataset (keep folder structure, ignore contents)
datasets/**
!datasets/place_dataset_dirs_here.txt

# Base weight files (gitignored; seeded by scripts/setup.sh)
weights/*.pt
*.pt

# Training outputs (large, generated per run)
/runs/

# Queue state, logs, PID (generated at runtime)
training_queue.json
runs/*.log
runs/.queue_runner.pid

# Legacy generated outputs
legacy/*/runs/
legacy/*/extracted_models/
legacy/*/training_queue.json
legacy/*/queue_progress.log
legacy/*/queue_output.log

# Ultralytics cache and settings
*.cache
ultralytics/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
